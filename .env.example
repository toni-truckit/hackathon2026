APP_NAME="TruckIt Connect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Host php artisan serve: http://localhost:8000
# APP_PORT=8080
# BUSINESS_API_NETWORK=truckit-for-business-api_app-network
# RUN_MIGRATIONS=false
# DOCKER_BOOTSTRAP_DB=true
APP_TIMEZONE="Asia/Kathmandu"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ne_NP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=truckit_mcp
DB_USERNAME=root
DB_PASSWORD=

# business-api MySQL (docker: join business-api network, host often db2)
BUSINESS_API_DB_HOST=127.0.0.1
BUSINESS_API_DB_PORT=3306
BUSINESS_API_DB_DATABASE=laravel
BUSINESS_API_DB_USERNAME=root
BUSINESS_API_DB_PASSWORD=
# BUSINESS_API_DB_SSL_CA=

# Monolith MySQL (same pattern as truckit-for-business-api)
MONOLITH_DB_HOST=127.0.0.1
MONOLITH_DB_PORT=3306
MONOLITH_DB_DATABASE=laravel
MONOLITH_DB_USERNAME=root
MONOLITH_DB_PASSWORD=
# MONOLITH_DB_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OG_IMAGE_ENABLED=true
OG_IMAGE_NODE_BINARY=
OG_IMAGE_NPM_BINARY=
OG_IMAGE_CHROME_PATH=
OG_IMAGE_NO_SANDBOX=true
OG_IMAGE_TIMEOUT=120
OG_IMAGE_IGNORE_HTTPS_ERRORS=true
OG_IMAGE_THROTTLE=30
OG_IMAGE_DEFAULT_IMAGE=

SEO_TWITTER_USERNAME=
