services:
  placeholder:
    image: public.ecr.aws/docker/library/nginx:1.27-alpine
    ports:
      - "80:80"
    volumes:
      - ./placeholder-nginx.conf:/etc/nginx/conf.d/default.conf:ro
    restart: unless-stopped
    logging:
      driver: awslogs
      options:
        awslogs-region: ${region}
        awslogs-group: ${log_group_nginx}
        awslogs-stream: placeholder
        awslogs-create-group: "true"
